# =============================
# LexiLingo — production secrets template
# =============================
# Copy to .env.production.secrets on the box and fill in real values:
#   cp .env.production.secrets.example .env.production.secrets
#
# Both compose files load this via `env_file`, so every key here reaches
# backend-service, ai-service and the celery workers without needing an entry
# in each service's `environment:` block.
#
# This file is committed; .env.production.secrets is not. Never put a real
# value here.

# ── Datastores ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────────────────────
# openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
GOOGLE_CLIENT_ID=
GOOGLE_ADMIN_CLIENT_ID=

# ── Internal service-to-service ──────────────────────────────────────────────
# backend -> ai-service (learner-card cache invalidation, /internal/diagnose).
# ai-service reads it with os.getenv, not only through Settings.
AI_ADMIN_API_KEY=

# ai-service -> backend (AI audit events, feeds the admin AI Quality page).
# Without it the ingest endpoint answers 403 and the page stays empty; the
# emitter is best-effort so nothing breaks, it just logs a warning per event.
# openssl rand -hex 32
AI_AUDIT_INGEST_SECRET=

# Partner API keys, stored as hashes (comma-separated).
LEXILINGO_PARTNER_API_KEY_HASHES=
TRACE_CAG_EXTERNAL_ENABLED=false
TRACE_CAG_SERVICE_TOKEN_HASH=

# ── LLM providers ────────────────────────────────────────────────────────────
# Exactly seven keys, comma-separated — compose asserts the count.
GROQ_API_KEYS=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=

# ── External content APIs ────────────────────────────────────────────────────
YOUTUBE_API_KEY=
NEWSAPI_KEY=
NEWSDATA_KEY=
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=
WORDSAPI_KEY=
DICTIONARY_API_BASE_URL=https://api.dictionaryapi.dev/api/v2/entries/en

# ── Mail ─────────────────────────────────────────────────────────────────────
SMTP_USERNAME=
SMTP_PASSWORD=
