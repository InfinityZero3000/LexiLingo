[Unit]
Description=LexiLingo backup restore verification
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/lexilingo
Environment=BACKUP_DIR=/opt/lexilingo/backups
# Restores the newest dump into a disposable container and asserts user data
# survived. Never touches production.
ExecStart=/usr/bin/bash /opt/lexilingo/scripts/verify-backup.sh
OnFailure=lexilingo-backup-alert@%N.service
