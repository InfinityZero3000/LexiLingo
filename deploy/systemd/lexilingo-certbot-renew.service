[Unit]
Description=Renew Let's Encrypt certificates for LexiLingo and reload gateway
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/lexilingo
ExecStart=/usr/bin/certbot renew --quiet --webroot -w /opt/lexilingo/gateway/nginx/acme-challenge --deploy-hook /usr/local/sbin/lexilingo-reload-gateway-after-renew
