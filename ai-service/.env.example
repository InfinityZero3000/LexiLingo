# ─── AI Service — ENV EXAMPLE ─────────────────────────────────────────────────
# Sao chép file này thành .env rồi điền các giá trị thực.
# Hoặc dùng: python3 env-switch.py dev|prod
# ──────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development   # development | production

# ── Error Tracking (Sentry — leave empty to disable) ─────────────────────────
SENTRY_DSN=

HOST=0.0.0.0
PORT=8001
DEBUG=false               # bật true chỉ khi debug local
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=lexilingo-qwen3-1.7b
OLLAMA_TIMEOUT=120
OLLAMA_CONTEXT_LENGTH=512
OLLAMA_MAX_TOKENS=128
OLLAMA_NUM_THREADS=8
OLLAMA_KEEP_ALIVE=10m

USE_GATEWAY=true
MAX_MEMORY_MB=8000
ENABLE_AUTO_UNLOAD=true
MODEL_DEVICE=auto         # auto | cpu | cuda

# ── Cloud AI APIs ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEYS=key1,key2,key3   # comma-separated multi-key pool; takes priority over GROQ_API_KEY
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MODEL_DIAGNOSE=           # override model for diagnose_node only; falls back to GROQ_MODEL
TRACECAG_PREFER_CLOUD_LLM=true # true = Groq/Gemini first, Ollama fallback; false = Ollama first
TAVILY_API_KEY=your_tavily_api_key_here

# ── Qwen Model ────────────────────────────────────────────────────────────────
QWEN_MODEL_NAME=Qwen/Qwen3-1.7B
QWEN_MAX_TOKENS=256
QWEN_TEMPERATURE=0.7

# ── Streaming STT ─────────────────────────────────────────────────────────────
STT_ENABLED=true
STT_AUDIO_FORMAT=pcm16
STT_SAMPLE_RATE=16000
STT_CHANNELS=1
STT_FRAME_MS=20
STT_PRIMARY_ENGINE=moonshine
STT_PRIMARY_MODEL=tiny_streaming
STT_PRIMARY_DEVICE=cpu
STT_FALLBACK_PRIMARY_ENGINE=sherpa
STT_SHERPA_MODEL_DIR=models/sherpa/sherpa-onnx-streaming-zipformer-en-20M-2023-02-17
STT_VAD_ENGINE=silero
STT_SILERO_MODEL_PATH=models/sherpa/silero_vad.onnx
STT_MIN_SPEECH_MS=250
STT_MIN_SILENCE_MS=600
STT_SPEECH_PAD_MS=200
STT_PRE_ROLL_MS=300
STT_MAX_SEGMENT_MS=12000
STT_HARD_CAP_SEGMENT_MS=15000
STT_VERIFY_ENABLED=true
STT_VERIFY_MODEL=base.en
STT_VERIFY_DEVICE=cpu
STT_VERIFY_COMPUTE_TYPE=int8
STT_VERIFY_LANGUAGE=en
STT_VERIFY_BEAM_SIZE=1
STT_VERIFY_TIMEOUT_MS=10000
STT_CONFIDENCE_ACCEPT=0.85
STT_CONFIDENCE_VERIFY=0.78
STT_RING_BUFFER_SECONDS=30
STT_TEMP_DIR=/tmp/stt_sessions
AUDIO_QUEUE_MAX_FRAMES=200
STT_MAX_ACTIVE_SESSIONS=20
STT_MAX_SESSIONS_PER_USER=2
STT_MAX_CONNECTIONS_PER_USER=3
STT_MAX_VERIFY_CONCURRENCY=2
STT_FIRST_MESSAGE_TIMEOUT_SECONDS=10
STT_SESSION_START_TIMEOUT_SECONDS=10
STT_SESSION_IDLE_TIMEOUT_SECONDS=60
STT_SESSION_HARD_LIMIT_MINUTES=60
STT_SESSION_STOP_TIMEOUT_SECONDS=3
STT_DOWNSTREAM_RESPONSE_TIMEOUT_SECONDS=35

# ── Piper (TTS) ───────────────────────────────────────────────────────────────
PIPER_MODEL_PATH=models/piper/en_US-lessac-low.onnx
PIPER_VOICE=en_US-lessac-low
PIPER_SAMPLE_RATE=16000

# ── HuBERT (Pronunciation) ────────────────────────────────────────────────────
HUBERT_MODEL_ID=facebook/hubert-large-ls960-ft
HUBERT_MODEL_PATH=models/hubert

# ── Redis ─────────────────────────────────────────────────────────────────────
# Dev:  redis://localhost:6379/1
# Prod: redis://:password@your-redis-host:6379/1
REDIS_URL=redis://localhost:6379/1
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Sparse learner-state rollout (off | shadow | read | primary)
LEARNER_STATE_MODE=off
LEARNER_STATE_API_URL=http://localhost:8000/api/v1/internal
LEARNER_STATE_INTERNAL_TOKEN=
LEARNER_STATE_INTERNAL_AUDIENCE=lexilingo-backend
LEARNER_STATE_DEADLINE_MS=40
LEARNER_STATE_CONNECT_TIMEOUT_MS=10
LEARNER_STATE_POOL_TIMEOUT_MS=5
LEARNER_STATE_MAX_INFLIGHT=100
LEARNER_STATE_CIRCUIT_FAILURES=5
LEARNER_STATE_CIRCUIT_RESET_SECONDS=30
KUZU_USER_MASTERY_WRITES_ENABLED=true
REDIS_TTL=3600

# ── Shared service-to-service auth key ───────────────────────────────────────
# Used by notification agent (X-Admin-Api-Key header). Must match backend-service AI_ADMIN_API_KEY.
AI_ADMIN_API_KEY=

# ── Internal CEFR content agent ───────────────────────────────────────────────
# Shared only with backend-service. Never expose this token to admin browsers.
CONTENT_AGENT_SERVICE_TOKEN=
CONTENT_AGENT_TTL_SECONDS=3600
CONTENT_AGENT_MAX_RECORDS=20000
CONTENT_AGENT_MAX_BATCH_RECORDS=2000
CONTENT_AGENT_ALLOW_LOCAL_STORE=true

# ── Licensed content ETL ──────────────────────────────────────────────────────
# Disabled until immutable source refs have been reviewed and pinned.
CONTENT_ETL_ENABLED=false
CONTENT_ETL_STORAGE_ROOT=/data/content-etl
CONTENT_ETL_HTTP_TIMEOUT_SECONDS=60
CONTENT_ETL_MAX_DOWNLOAD_BYTES=1073741824
CONTENT_ETL_MAX_QUARANTINE_RATIO=0.02
CONTENT_ETL_USER_AGENT=LexiLingo-ETL/1.0
CONTENT_ETL_OEWN_VERSION=2025
CONTENT_ETL_OEWN_SHA256=
CONTENT_ETL_CMU_REF=
CONTENT_ETL_CMU_SHA256=
CONTENT_ETL_CEFR_J_REF=
CONTENT_ETL_CEFR_J_PATH=cefrj-vocabulary-profile-1.5.csv
CONTENT_ETL_CEFR_J_SHA256=
CONTENT_ETL_WIKIDATA_SNAPSHOT=
CONTENT_ETL_TATOEBA_RELEASE=
CONTENT_ETL_LIBRISPEECH_RELEASE=
CONTENT_ETL_COMMON_VOICE_RELEASE=

# ── MongoDB / Azure Cosmos DB Emulator (Mongo API) ───────────────────────────
# Local Dev (Cosmos Emulator, chỉ dùng local):
# mongodb://localhost:<EMULATOR_KEY>@localhost:10255/?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000&tlsAllowInvalidCertificates=true
# Prod: dùng MONGODB_ATLAS_URI bên dưới (hoặc Cosmos cloud endpoint)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=lexilingo_dev   # lexilingo_prod trong production
MONGODB_ATLAS_URI=               # mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_TLS_ALLOW_INVALID_CERTIFICATES=false

# ── KuzuDB (Graph) ────────────────────────────────────────────────────────────
KUZU_DB_PATH=data/kuzu_runtime.db
# Runtime sources only. Benchmark scripts must use explicit paths under
# model-development/benchmark and set TRACECAG_KG_ALLOW_BENCHMARK=true.
KG_DATA_DIR=data/kg

# ── Backend service ───────────────────────────────────────────────────────────
# Dev:  primary = local
# Prod: primary = public gateway
BACKEND_SERVICE_URL=http://localhost:8000
BACKEND_SERVICE_URL_FALLBACK=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Dev:  localhost ports
# Prod: các domain chính thức, không dùng wildcard khi credentials=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_ORIGIN_REGEX=

# ── Features ─────────────────────────────────────────────────────────────────
ENABLE_TTS=true
TTS_INTRA_OP_THREADS=4  # 0=ONNX default; valid range 0..16
ENABLE_STT=true
ENABLE_PRONUNCIATION=true
ENABLE_VIETNAMESE_HINTS=true
ENABLE_GRAPH_CAG=true

# ── Idle timeouts (giây) ─────────────────────────────────────────────────────
QWEN_IDLE_TIMEOUT=600
WHISPER_IDLE_TIMEOUT=300
PIPER_IDLE_TIMEOUT=300
HUBERT_IDLE_TIMEOUT=180
GEMINI_IDLE_TIMEOUT=1800
REQUEST_TIMEOUT=30

# ── JWT authentication (must be identical to backend SECRET_KEY) ──────────────
SECRET_KEY=your_backend_secret_key_here
ALGORITHM=HS256
AI_JWT_ISSUER=lexilingo-backend
AI_JWT_AUDIENCE=lexilingo-services
