# ─── AI Service — ENV EXAMPLE ─────────────────────────────────────────────────
# Sao chép file này thành .env rồi điền các giá trị thực.
# Hoặc dùng: python3 env-switch.py dev|prod
# ──────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development   # development | production

HOST=0.0.0.0
PORT=8001
DEBUG=true                # false trong production
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=lexilingo-qwen3-1.7b
OLLAMA_TIMEOUT=120
OLLAMA_CONTEXT_LENGTH=512
OLLAMA_MAX_TOKENS=128
OLLAMA_NUM_THREADS=8
OLLAMA_KEEP_ALIVE=10m

USE_GATEWAY=true
MAX_MEMORY_MB=8000
ENABLE_AUTO_UNLOAD=true
MODEL_DEVICE=auto         # auto | cpu | cuda

# ── Cloud AI APIs ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3-32b
TAVILY_API_KEY=your_tavily_api_key_here

# ── Qwen Model ────────────────────────────────────────────────────────────────
USE_QWEN=false
QWEN_MODEL_NAME=Qwen/Qwen3-1.7B-Instruct
QWEN_MODEL_PATH=models/qwen
QWEN_DEVICE=auto
QWEN_MAX_TOKENS=256
QWEN_TEMPERATURE=0.7

# ── Whisper (STT) ─────────────────────────────────────────────────────────────
WHISPER_MODEL_SIZE=base   # tiny | base | small | medium | large
WHISPER_MODEL_PATH=models/whisper
WHISPER_LANGUAGE=en
WHISPER_COMPUTE_TYPE=int8

# ── Piper (TTS) ───────────────────────────────────────────────────────────────
PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx
PIPER_VOICE=en_US-lessac-medium
PIPER_SAMPLE_RATE=22050

# ── HuBERT (Pronunciation) ────────────────────────────────────────────────────
HUBERT_MODEL_ID=facebook/hubert-large-ls960-ft
HUBERT_MODEL_PATH=models/hubert

# ── Redis ─────────────────────────────────────────────────────────────────────
# Dev:  redis://localhost:6379/1
# Prod: redis://:password@your-redis-host:6379/1
REDIS_URL=redis://localhost:6379/1
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_TTL=3600

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Dev:  mongodb://localhost:27017
# Prod: (dùng MONGODB_ATLAS_URI bên dưới, để MONGODB_URI trống)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=lexilingo_dev   # lexilingo_prod trong production
MONGODB_ATLAS_URI=               # mongodb+srv://user:pass@cluster.mongodb.net/

# ── KuzuDB (Graph) ────────────────────────────────────────────────────────────
KUZU_DB_PATH=data/kuzu_db

# ── Backend service ───────────────────────────────────────────────────────────
# Dev:  primary = local, fallback = Render.com
# Prod: primary = Render.com, fallback = (để trống)
BACKEND_SERVICE_URL=http://localhost:8000
BACKEND_SERVICE_URL_FALLBACK=https://lexilingo-4gu6.onrender.com

# ── CORS ─────────────────────────────────────────────────────────────────────
# Dev:  localhost ports
# Prod: các domain Vercel chính thức
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Features ─────────────────────────────────────────────────────────────────
ENABLE_TTS=true
ENABLE_STT=true
ENABLE_PRONUNCIATION=true
ENABLE_VIETNAMESE_HINTS=true
ENABLE_GRAPH_CAG=true

# ── Idle timeouts (giây) ─────────────────────────────────────────────────────
QWEN_IDLE_TIMEOUT=600
WHISPER_IDLE_TIMEOUT=300
PIPER_IDLE_TIMEOUT=300
HUBERT_IDLE_TIMEOUT=180
GEMINI_IDLE_TIMEOUT=1800
REQUEST_TIMEOUT=30

# ── Hugging Face ─────────────────────────────────────────────────────────────
HF_HOME=models/huggingface
HF_TOKEN=   # cần nếu dùng private models
