# Optional deploy-source file. Flutter web now bundles only
# assets/env/*_config, so do not put server API keys here.

# Backend base URL (without trailing slash).
API_BASE_URL=https://api.lexilingo.me/api/v1

# AI service base URL (without trailing slash).
AI_SERVICE_URL=https://api.lexilingo.me/api/v1
VOICE_DUPLEX_ENABLED=false

# Google Sign-In Server Client ID. This is public client config.
GOOGLE_SERVER_CLIENT_ID=your-firebase-web-client-id.apps.googleusercontent.com

# Gemini/HuggingFace/API provider keys belong in backend/AI service env only.
