# Backend base URL (without trailing slash)
API_BASE_URL=http://localhost:8000/api/v1
# AI service base URL (without trailing slash)
AI_SERVICE_URL=http://localhost:8001/api/v1

# Google Gemini API Key (Get from: https://ai.google.dev/)
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace API Key (Optional - for fallback, Get from: https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Google Sign-In Server Client ID (for Android/iOS, used for backend token verification)
GOOGLE_SERVER_CLIENT_ID=your-google-server-client-id.apps.googleusercontent.com

# Firebase config is loaded via firebase_options.dart; keep this file secret.
