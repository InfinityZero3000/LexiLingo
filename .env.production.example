# =============================
# Core deployment mode
# =============================
APP_ENV=production
APP_VERSION=1.0.1
DEBUG=False
LOG_LEVEL=INFO

# =============================
# Nginx Gateway (public edge)
# =============================
# Public DNS name served by the gateway.
GATEWAY_SERVER_NAME=api.lexilingo.com
# Certificate/key path inside gateway container (mounted from host /etc/letsencrypt).
GATEWAY_SSL_CERT_PATH=/etc/letsencrypt/live/api.lexilingo.com/fullchain.pem
GATEWAY_SSL_KEY_PATH=/etc/letsencrypt/live/api.lexilingo.com/privkey.pem

# VPS host swap tuning (documented in scripts/setup-vps-swap.sh)
SWAP_SIZE_GB=4
VM_SWAPPINESS=10
VM_VFS_CACHE_PRESSURE=50

# =============================
# PostgreSQL (backend)
# =============================
POSTGRES_USER=lexilingo
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=lexilingo

# =============================
# Backend security
# =============================
SECRET_KEY=change_me_super_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated origins allowed by backend + AI
ALLOWED_ORIGINS=https://lexilingo.com,https://api.lexilingo.com,https://lexilingo.vercel.app
CORS_ALLOW_ORIGIN_REGEX=https?://([a-zA-Z0-9-]+\.)*vercel\.app(:\d+)?|https?://([a-zA-Z0-9-]+\.)*netlify\.app(:\d+)?|https?://.*\.devtunnels\.ms(:\d+)?

# Firebase (backend)
FIREBASE_PROJECT_ID=lexilingo-88492
# Prefer mounting file in production and set path below if needed:
FIREBASE_CREDENTIALS_FILE=/app/firebase-service-account.json
# Optional inline JSON alternative:
FIREBASE_CREDENTIALS_JSON=

# Optional admin OAuth settings
GOOGLE_CLIENT_ID=
GOOGLE_ADMIN_CLIENT_ID=
ADMIN_EMAIL_WHITELIST=
SUPER_ADMIN_EMAIL_WHITELIST=

# Backend email settings (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_USE_SSL=False
EMAIL_FROM=noreply@lexilingo.app
PASSWORD_RESET_URL_BASE=https://lexilingo.com/reset-password
PASSWORD_RESET_URL_BASE_PRODUCTION=https://lexilingo.com/reset-password

# =============================
# AI service
# =============================
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=

# If you run Ollama on VPS host (outside containers):
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=lexilingo-qwen3-1.7b
OLLAMA_TIMEOUT=60

# AI model names (optional override)
QWEN_MODEL_NAME=
LLAMA_MODEL_NAME=vilm/vinallama-7b-chat
HUBERT_MODEL_NAME=facebook/hubert-large-ls960-ft
HUBERT_DEVICE=cpu

# STT / TTS
STT_MODEL_NAME=large-v3
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_BEAM_SIZE=5
STT_VAD=true
STT_LANGUAGE=en
TTS_MODEL_PATH=en_US-lessac-medium
TTS_CONFIG_PATH=
TTS_SPEAKER_ID=0
TTS_VOICE=en_US-lessac-medium

# MongoDB
MONGODB_DATABASE=lexilingo
MONGODB_TLS_ALLOW_INVALID_CERTIFICATES=false
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Redis
REDIS_PASSWORD=

# External content APIs (backend optional)
YOUTUBE_API_KEY=
NEWSAPI_KEY=
NEWSDATA_KEY=
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=
WORDSAPI_KEY=
