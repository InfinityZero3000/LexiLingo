# Test environment configuration
# Copy this to .env.test and fill in values before running tests.
#
# IMPORTANT: TEST_DATABASE_URL MUST point to a database whose name ends with _test.
# The test suite drops and recreates the public schema on every run.
# Pointing at a production or development database will destroy its data.
#
# Setup (one-time):
#   createdb -U lexilingo lexilingo_test
#   # or via psql:
#   psql -U postgres -c "CREATE DATABASE lexilingo_test OWNER lexilingo;"
#
# Teardown is automatic — the fixture drops and recreates the schema each run.

# Required
TEST_DATABASE_URL=postgresql+asyncpg://lexilingo:lexilingo_pass@localhost:5432/lexilingo_test
SECRET_KEY=test-only-secret-key-not-for-production
DATABASE_URL=postgresql+asyncpg://lexilingo:lexilingo_pass@localhost:5432/lexilingo_test

# Always false in tests — set by conftest.py automatically
DEBUG=false
APP_ENV=testing

# Redis — set to a test-only DB index to avoid colliding with dev cache
REDIS_URL=redis://localhost:6379/1

# Leave external API keys empty in tests; mocks cover them
YOUTUBE_API_KEY=
NEWSAPI_KEY=
NEWSDATA_KEY=
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=
GOOGLE_CLIENT_ID=
GOOGLE_ADMIN_CLIENT_ID=
