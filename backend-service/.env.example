# Application
APP_NAME=LexiLingo Backend Service
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=False
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://lexilingo:lexilingo_pass@localhost:5432/lexilingo
DB_ECHO=False
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Security
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
JWT_ISSUER=lexilingo-backend
JWT_AUDIENCE=lexilingo-services
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Partner Integration API Keys
# Managed in the `partner_api_keys` DB table (app/models/partner.py), not env
# vars. Keys are passed via the `X-LexiLingo-API-Key` header on
# /integrations/* routes and looked up by SHA-256 hash.
#
# To issue a key: insert a row with key_id, key_hash = sha256(raw_key), owner,
# scope. To rotate: insert the new row, hand out the new key, then set
# revoked_at on the old row once the partner has switched over — both remain
# valid in the meantime. To revoke: set revoked_at (or expires_at) on the row.

# CORS (Flutter app origins)
ENABLE_APP_CORS=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:52000
CORS_ALLOW_ORIGIN_REGEX=
ALLOWED_HOSTS=localhost,127.0.0.1,api.lexilingo.me

# Logging
LOG_LEVEL=INFO

# Error Tracking (Sentry — leave empty to disable)
SENTRY_DSN=

# Password reset email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=noreply@lexilingo.app
# Flutter web reset screen route
PASSWORD_RESET_URL_BASE=http://localhost:8080/#/reset-password
EMAIL_VERIFICATION_URL_BASE=http://localhost:8080/#/verify-email

# AI Service URL (optional - for future integration)
AI_SERVICE_URL=http://localhost:8001/api/v1
AI_ADMIN_API_KEY=
LEARNER_STATE_ENABLED=false
LEARNER_STATE_INTERNAL_TOKEN=
LEARNER_STATE_INTERNAL_TOKEN_PREVIOUS=
LEARNER_STATE_INTERNAL_TOKEN_PREVIOUS_EXPIRES_AT=
LEARNER_STATE_INTERNAL_AUDIENCE=lexilingo-backend
LEARNER_STATE_OUTBOX_BATCH_SIZE=100
LEARNER_STATE_OUTBOX_POLL_MS=100
LEARNER_STATE_OUTBOX_LEASE_SECONDS=30
LEARNER_STATE_OUTBOX_MAX_ATTEMPTS=10
LEARNER_STATE_STATEMENT_TIMEOUT_MS=100
LEARNER_STATE_MAX_BODY_BYTES=524288
CONTENT_AGENT_ENABLED=false
CONTENT_AGENT_SERVICE_TOKEN=
CONTENT_AGENT_UPLOAD_TTL_DAYS=7
CONTENT_AGENT_AI_TIMEOUT_SECONDS=120

# RevenueCat (server-side entitlement verification)
REVENUECAT_SECRET_API_KEY=
REVENUECAT_TIMEOUT_SECONDS=5.0

# Licensed Content ETL (managed by ai-service; backend only reads this flag)
CONTENT_ETL_ENABLED=false

# Redis (cache + quota tracking)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
# Trusted reverse-proxy IPs (comma-separated) allowed to set X-Forwarded-For.
# Leave empty for dev. In production set to your load balancer / Render proxy IPs.
TRUSTED_PROXIES=

# FSRS reminder scheduler
# PRODUCTION: đặt REMINDERS_ENABLED=true và REMINDER_DRY_RUN=false để bật push notification
# Nếu để false, Celery sẽ không gửi bất kỳ thông báo nào dù user đã bật setting
REMINDERS_ENABLED=false
REMINDER_DRY_RUN=true
REMINDER_SCAN_BATCH_SIZE=250
REMINDER_SCAN_INTERVAL_SECONDS=300
REMINDER_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
REMINDER_REVIEW_ROUTE=/vocabulary/review
APP_PUBLIC_URL=https://lexilingo.me

# Celery. Defaults to REDIS_URL when empty.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Firebase Auth (optional - for verifying Firebase ID tokens)
FIREBASE_PROJECT_ID=
# One of the following must be provided
# Paste JSON directly (escape quotes/newlines if needed)
FIREBASE_CREDENTIALS_JSON=
# Or point to a JSON file path — must be OUTSIDE this repo/project directory
# in production (a runtime secret mount, e.g. /run/secrets/firebase.json);
# an in-repo path is fine for local dev only (APP_ENV != production).
# FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase.json

# Google OAuth
# Get these from Google Cloud Console -> APIs & Services -> Credentials
# Firebase web OAuth Client ID (also usable as serverClientId for mobile sign-in)
GOOGLE_CLIENT_ID=your-firebase-web-client-id.apps.googleusercontent.com
# Admin Web Client ID (can be the same Firebase web OAuth client if shared across web/app)
GOOGLE_ADMIN_CLIENT_ID=your-web-admin-google-client-id.apps.googleusercontent.com

# External Content APIs (Phase 1-5 features)
# YouTube Video + Captions
YOUTUBE_API_KEY=
# News Reading (primary + fallback)
NEWSAPI_KEY=
NEWSDATA_KEY=
# Podcast search
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=
# Optional dictionary enhancement
WORDSAPI_KEY=
