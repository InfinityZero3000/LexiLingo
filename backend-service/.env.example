# Application
APP_NAME=LexiLingo Backend Service
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=False
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://lexilingo:lexilingo_pass@localhost:5432/lexilingo
DB_ECHO=False
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Security
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Flutter app origins)
ENABLE_APP_CORS=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:52000
CORS_ALLOW_ORIGIN_REGEX=
ALLOWED_HOSTS=localhost,127.0.0.1,api.lexilingo.me

# Logging
LOG_LEVEL=INFO

# Password reset email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=noreply@lexilingo.app
# Flutter web reset screen route
PASSWORD_RESET_URL_BASE=http://localhost:8080/#/reset-password
EMAIL_VERIFICATION_URL_BASE=http://localhost:8080/#/verify-email

# AI Service URL (optional - for future integration)
AI_SERVICE_URL=http://localhost:8001/api/v1

# Redis (cache + quota tracking)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
# Trusted reverse-proxy IPs (comma-separated) allowed to set X-Forwarded-For.
# Leave empty for dev. In production set to your load balancer / Render proxy IPs.
TRUSTED_PROXIES=

# Firebase Auth (optional - for verifying Firebase ID tokens)
FIREBASE_PROJECT_ID=
# One of the following must be provided
# Paste JSON directly (escape quotes/newlines if needed)
FIREBASE_CREDENTIALS_JSON=
# Or point to a JSON file path
# FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json

# Google OAuth
# Get these from Google Cloud Console -> APIs & Services -> Credentials
# Firebase web OAuth Client ID (also usable as serverClientId for mobile sign-in)
GOOGLE_CLIENT_ID=your-firebase-web-client-id.apps.googleusercontent.com
# Admin Web Client ID (can be the same Firebase web OAuth client if shared across web/app)
GOOGLE_ADMIN_CLIENT_ID=your-web-admin-google-client-id.apps.googleusercontent.com

# External Content APIs (Phase 1-5 features)
# YouTube Video + Captions
YOUTUBE_API_KEY=
# News Reading (primary + fallback)
NEWSAPI_KEY=
NEWSDATA_KEY=
# Podcast search
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=
# Optional dictionary enhancement
WORDSAPI_KEY=
